<?php

/**
 * @file
 * Install file del modulo Custom config keryx.
 */

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Site\Settings;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\user\Entity\Role;

/**
 * Ruoli dei responsabili della pubblicazione.
 *
 * L'amministratore non è elencato: il ruolo amministratore ha già tutti i
 * permessi.
 */
const CUSTOM_CONFIG_KERYX_ALBO_STORICO_ROLES = [
  'dirigente_scolastico',
  'direttore_amministrativo_dsga_',
];

/**
 * Permessi assegnati ai responsabili della pubblicazione.
 */
const CUSTOM_CONFIG_KERYX_RESPONSABILI_PERMISSIONS = [
  'access albo storico',
  'annulla atti albo',
];

/**
 * Implements hook_install().
 */
function custom_config_keryx_install() {
  _custom_config_keryx_grant_albo_storico_permission();
  _custom_config_keryx_allegati_private();
  _custom_config_keryx_blocchi_at_tema();
}

/**
 * Allegati di documenti e circolari nello schema privato.
 */
function custom_config_keryx_update_10001() {
  return _custom_config_keryx_allegati_private();
}

/**
 * Permesso "Annullare atti dell'Albo online" a Dirigente e DSGA.
 */
function custom_config_keryx_update_10002() {
  $granted = _custom_config_keryx_grant_albo_storico_permission();
  return $granted
    ? (string) t('Permessi dei responsabili della pubblicazione assegnati a: @roles.', ['@roles' => implode(', ', $granted)])
    : (string) t('Permessi dei responsabili della pubblicazione già assegnati.');
}

/**
 * Configurazione delle regole di pubblicazione per tipologia.
 */
function custom_config_keryx_update_10003() {
  $config = \Drupal::configFactory()->getEditable('custom_config_keryx.settings');
  if (!$config->isNew()) {
    return (string) t('Regole di pubblicazione già configurate.');
  }
  $config->setData(['tipologie_solo_at' => [], 'tipologie_non_pubblicabili' => []])->save();
  return (string) t('Creata la configurazione delle regole di pubblicazione: compilarla in Configurazione > Ouitoulía > Keryx: regole di pubblicazione.');
}

/**
 * Albo storico: riallinea la vista alla versione del modulo.
 *
 * Esclude i documenti di Amministrazione Trasparente (filtro "senza obbligo
 * di pubblicazione") e porta sui siti già installati le modifiche alla
 * tabella e ai filtri. La vista è del modulo (dipendenza enforced): eventuali
 * modifiche fatte dall'interfaccia vengono sostituite.
 */
function custom_config_keryx_update_10004() {
  $path = \Drupal::service('extension.list.module')->getPath('custom_config_keryx') . '/config/install';
  $data = (new FileStorage($path))->read('views.view.albo_storico');
  $storage = \Drupal::entityTypeManager()->getStorage('view');

  $view = $storage->load('albo_storico');
  if ($view) {
    $data['uuid'] = $view->uuid();
    $view = $storage->updateFromStorageRecord($view, $data);
  }
  else {
    $view = $storage->createFromStorageRecord($data);
  }
  $view->save();

  return (string) t('Vista dell\'albo storico aggiornata: esclusi i documenti di Amministrazione Trasparente.');
}

/**
 * Sezione "Obblighi precedenti il 31/12/2023" di Bandi di gara e contratti.
 */
const CUSTOM_CONFIG_KERYX_SEZIONE_ANTE_2024 = 9123;

/**
 * Obblighi della sezione ante 2024 in cui si pubblicano documenti.
 *
 * 9589 singole procedure (L. 190/2012 art. 1 c. 32), 9590 tabelle riassuntive,
 * 9594 delibera a contrarre, 9598 contratti, 9606 progetti di investimento.
 */
const CUSTOM_CONFIG_KERYX_OBBLIGHI_ANTE_2024 = [9589, 9590, 9594, 9598, 9606];

/**
 * Pubblica la sezione "Obblighi precedenti il 31/12/2023" di Bandi di gara.
 *
 * keryx la installa non pubblicata, ma gli atti delle procedure avviate prima
 * del 2024 restano soggetti alla disciplina previgente (delibera ANAC
 * 601/2023) e devono restare consultabili per 5 anni (D.Lgs. 33/2013 art. 8
 * c. 3). Si pubblicano la sezione e i soli obblighi che contengono documenti:
 * gli altri restano spenti, senza voci vuote nel menu.
 *
 * Attenzione: rilanciare con --update la migrazione degli obblighi di keryx
 * ripristina lo stato "non pubblicato"; in quel caso rieseguire
 * _custom_config_keryx_pubblica_sezione_ante_2024().
 */
function custom_config_keryx_update_10005() {
  return _custom_config_keryx_pubblica_sezione_ante_2024();
}

/**
 * Pubblica la sezione ante 2024 e i suoi obblighi con documenti.
 *
 * @return string
 *   L'esito, anche per drush updb.
 */
function _custom_config_keryx_pubblica_sezione_ante_2024() {
  $storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
  $pubblicati = [];

  foreach ($storage->loadMultiple(array_merge([CUSTOM_CONFIG_KERYX_SEZIONE_ANTE_2024], CUSTOM_CONFIG_KERYX_OBBLIGHI_ANTE_2024)) as $term) {
    if (!$term->isPublished()) {
      $term->setPublished()->save();
      $pubblicati[] = $term->id();
    }
  }

  if (!$pubblicati) {
    return (string) t('Sezione "Obblighi precedenti il 31/12/2023" già pubblicata (o assente).');
  }
  \Drupal::logger('custom_config_keryx')->notice('Pubblicati i termini della sezione "Obblighi precedenti il 31/12/2023": @tids.', ['@tids' => implode(', ', $pubblicati)]);
  return (string) t('Pubblicati la sezione "Obblighi precedenti il 31/12/2023" e i suoi obblighi con documenti (@tids).', ['@tids' => implode(', ', $pubblicati)]);
}

/**
 * Assegna i permessi dell'albo ai responsabili della pubblicazione.
 *
 * I ruoli non presenti nel sito vengono ignorati.
 *
 * @return string[]
 *   Le etichette dei ruoli a cui è stato assegnato almeno un permesso.
 */
function _custom_config_keryx_grant_albo_storico_permission() {
  $granted = [];

  foreach (Role::loadMultiple(CUSTOM_CONFIG_KERYX_ALBO_STORICO_ROLES) as $role) {
    $mancanti = array_filter(CUSTOM_CONFIG_KERYX_RESPONSABILI_PERMISSIONS, fn($permission) => !$role->hasPermission($permission));
    if ($mancanti) {
      foreach ($mancanti as $permission) {
        $role->grantPermission($permission);
      }
      $role->save();
      $granted[] = $role->label();
    }
  }

  if ($granted) {
    \Drupal::logger('custom_config_keryx')->notice(
      'Permessi dei responsabili della pubblicazione (albo storico, annullamento) assegnati ai ruoli: @roles.',
      ['@roles' => implode(', ', $granted)]
    );
  }

  return $granted;
}

/**
 * Porta gli allegati di documenti e circolari nello schema privato.
 *
 * I file pubblici sono serviti direttamente dal server web: restano
 * scaricabili anche dopo la scadenza della pubblicazione e non possono avere
 * il noindex. Nello schema privato passano da Drupal, che ne controlla
 * l'accesso (Regolamento dell'albo, artt. 2 e 9; Garante, Linee guida
 * n. 243/2014). Il campo field_allegati è condiviso da documento e circolare.
 *
 * Lo schema si cambia solo se:
 * - il percorso privato è configurato e sta fuori dalla docroot;
 * - il campo non contiene ancora file (quelli esistenti andrebbero spostati).
 *
 * @return string
 *   L'esito, anche per drush updb.
 */
function _custom_config_keryx_allegati_private() {
  $logger = \Drupal::logger('custom_config_keryx');
  $storage = FieldStorageConfig::loadByName('node', 'field_allegati');

  if (!$storage) {
    return (string) t('Campo field_allegati assente: nessuna modifica.');
  }
  if ($storage->getSetting('uri_scheme') === 'private') {
    return (string) t('Gli allegati di documenti e circolari sono già nello schema privato.');
  }

  $private_path = Settings::get('file_private_path');
  $private_real = $private_path ? realpath($private_path) : FALSE;
  if (!$private_real || str_starts_with($private_real . '/', realpath(DRUPAL_ROOT) . '/')) {
    $message = t('Allegati NON portati nello schema privato: configurare in settings.php un file_private_path esistente e fuori dalla docroot, poi eseguire di nuovo drush updb.');
    $logger->error($message);
    return (string) $message;
  }

  if ($storage->hasData()) {
    $message = t('Allegati NON portati nello schema privato: il campo contiene già file, da spostare con una procedura dedicata.');
    $logger->error($message);
    return (string) $message;
  }

  $storage->setSetting('uri_scheme', 'private')->save();
  $message = t('Allegati di documenti e circolari portati nello schema privato (private://).');
  $logger->notice($message);
  return (string) $message;
}

/**
 * Blocchi di navigazione dell'Amministrazione Trasparente nel tema del sito.
 */
function custom_config_keryx_update_10006() {
  return _custom_config_keryx_blocchi_at_tema();
}

/**
 * Posiziona i blocchi di navigazione dell'AT nel tema predefinito.
 *
 * keryx posiziona il menu delle sezioni e l'elenco delle sottosezioni
 * (viste amministrazione_trasparente, display "menu" e "tipologie_dati") solo
 * nel tema skenografia. In un sottotema usato come tema predefinito (es.
 * skholeio) le pagine di sezione restano senza sottosezioni e obblighi: la
 * sezione Amministrazione Trasparente non è navigabile (D.Lgs. 33/2013
 * art. 9 e all. 1). I blocchi vengono copiati con regione, peso e visibilità
 * di skenografia, solo se il tema non li ha già.
 *
 * @return string
 *   L'esito, anche per drush updb.
 */
function _custom_config_keryx_blocchi_at_tema() {
  $tema = \Drupal::config('system.theme')->get('default');
  $temi = \Drupal::service('theme_handler')->listInfo();
  if ($tema === 'skenografia' || !isset($temi[$tema]) || !isset($temi[$tema]->base_themes['skenografia'])) {
    return (string) t('Blocchi dell\'Amministrazione Trasparente: il tema @tema non è un sottotema di skenografia, nessuna modifica.', ['@tema' => $tema]);
  }

  $storage = \Drupal::entityTypeManager()->getStorage('block');
  $regioni = system_region_list($tema);
  $creati = [];
  foreach (['views_block:amministrazione_trasparente-menu', 'views_block:amministrazione_trasparente-tipologie_dati'] as $plugin) {
    if ($storage->loadByProperties(['theme' => $tema, 'plugin' => $plugin])) {
      continue;
    }
    $origine = $storage->loadByProperties(['theme' => 'skenografia', 'plugin' => $plugin]);
    $origine = reset($origine);
    if (!$origine || !isset($regioni[$origine->getRegion()])) {
      continue;
    }
    $id = $tema . '_' . preg_replace('/^skenografia_/', '', $origine->id());
    $blocco = $origine->createDuplicateBlock($id, $tema);
    $blocco->save();
    $creati[] = $blocco->id();
  }

  if (!$creati) {
    return (string) t('Blocchi dell\'Amministrazione Trasparente già presenti nel tema @tema.', ['@tema' => $tema]);
  }
  \Drupal::logger('custom_config_keryx')->notice('Blocchi dell\'Amministrazione Trasparente posizionati nel tema @tema: @ids.', ['@tema' => $tema, '@ids' => implode(', ', $creati)]);
  return (string) t('Blocchi dell\'Amministrazione Trasparente posizionati nel tema @tema: @ids.', ['@tema' => $tema, '@ids' => implode(', ', $creati)]);
}
