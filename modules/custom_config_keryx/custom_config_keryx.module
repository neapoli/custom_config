<?php

use Drupal\Core\Access\AccessResult;
use Drupal\Core\Datetime\DrupalDateTime;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;
use Drupal\datetime\Plugin\Field\FieldType\DateTimeItemInterface;
use Drupal\node\NodeInterface;

/**
 * Campo che contiene il numero di registro dell'Albo online.
 */
const CUSTOM_CONFIG_KERYX_REGISTRO_FIELD = 'field_codice_identificativo';

/**
 * Cifre del progressivo annuale: anno + 6 cifre (es. 2026000489), come PASW.
 */
const CUSTOM_CONFIG_KERYX_REGISTRO_CIFRE = 6;

/**
 * Nome del lock che serializza l'assegnazione dei numeri di registro.
 */
const CUSTOM_CONFIG_KERYX_REGISTRO_LOCK = 'custom_config_keryx_registro';

/**
 * Indica se il documento è un atto dell'Albo online.
 *
 * Atto dell'albo = documento con numero di protocollo e senza obbligo di
 * pubblicazione di Amministrazione Trasparente.
 */
function _custom_config_keryx_is_atto_albo(NodeInterface $node): bool {
  if ($node->bundle() !== 'documento' || !$node->hasField('field_protocollo') || $node->get('field_protocollo')->isEmpty()) {
    return FALSE;
  }
  return !$node->hasField('field_obbligo_di_pubblicazione') || $node->get('field_obbligo_di_pubblicazione')->isEmpty();
}

/**
 * Implements hook_node_presave().
 *
 * Numero di registro dell'Albo online (Regolamento dell'albo, art. 6):
 * assegnato automaticamente alla prima pubblicazione di un atto, progressivo
 * per anno solare, non modificabile una volta assegnato.
 */
function custom_config_keryx_node_presave(NodeInterface $node) {
  if ($node->bundle() !== 'documento' || !$node->hasField(CUSTOM_CONFIG_KERYX_REGISTRO_FIELD)) {
    return;
  }
  _custom_config_keryx_non_pubblicabile($node);

  $field = CUSTOM_CONFIG_KERYX_REGISTRO_FIELD;
  $original = $node->isNew() ? NULL : ($node->original ?? NULL);

  // Numero già assegnato: non si modifica.
  if ($original && !$original->get($field)->isEmpty() && _custom_config_keryx_is_atto_albo($original)) {
    $assegnato = $original->get($field)->value;
    if ($node->get($field)->value !== $assegnato) {
      $node->set($field, $assegnato);
      \Drupal::logger('custom_config_keryx')->warning(
        'Tentativo di modificare il numero di registro @numero dell\'atto @nid: modifica annullata.',
        ['@numero' => $assegnato, '@nid' => $node->id()]
      );
    }
    return;
  }

  // Assegnazione alla prima pubblicazione di un atto dell'albo.
  if (!$node->isPublished() || !$node->get($field)->isEmpty() || !_custom_config_keryx_is_atto_albo($node)) {
    return;
  }

  $lock = \Drupal::lock();
  while (!$lock->acquire(CUSTOM_CONFIG_KERYX_REGISTRO_LOCK, 30)) {
    $lock->wait(CUSTOM_CONFIG_KERYX_REGISTRO_LOCK, 5);
  }
  // Il lock viene rilasciato dopo il salvataggio (hook_node_insert/update).
  $node->custom_config_keryx_registro_lock = TRUE;

  $node->set($field, _custom_config_keryx_next_registro((new DrupalDateTime('now'))->format('Y')));
}

/**
 * Indica se il documento ha una tipologia "non pubblicabile".
 */
function _custom_config_keryx_is_non_pubblicabile(NodeInterface $node): bool {
  $tipologia = _custom_config_keryx_tipologia($node);
  return $tipologia !== NULL && in_array($tipologia, \Drupal::config('custom_config_keryx.settings')->get('tipologie_non_pubblicabili') ?? [], TRUE);
}

/**
 * Documenti non pubblicabili: sempre non pubblicati, nell'archivio riservato.
 *
 * Contratti individuali e incarichi nominativi del personale contengono dati
 * personali che nessuna norma impone di pubblicare (Regolamento dell'albo,
 * artt. 4 e 7; Garante, Linee guida n. 243/2014). Il documento si salva come
 * non pubblicato e con data di oblio non futura, così è consultabile subito
 * nell'albo storico riservato. Vale per ogni via di salvataggio (form, API);
 * le migrazioni li importano già non pubblicati e con date passate.
 */
function _custom_config_keryx_non_pubblicabile(NodeInterface $node): void {
  if (!_custom_config_keryx_is_non_pubblicabile($node)) {
    return;
  }

  $corretto = FALSE;
  if ($node->isPublished()) {
    $node->setUnpublished();
    $corretto = TRUE;
  }

  if ($node->hasField('field_data_oblio')) {
    $adesso = new DrupalDateTime('now', DateTimeItemInterface::STORAGE_TIMEZONE);
    $valore = $node->get('field_data_oblio')->value;
    if (!$valore || new DrupalDateTime($valore, DateTimeItemInterface::STORAGE_TIMEZONE) > $adesso) {
      $node->set('field_data_oblio', $adesso->format(DateTimeItemInterface::DATETIME_STORAGE_FORMAT));
    }
  }

  if ($corretto) {
    $tipologia = _custom_config_keryx_tipologia($node);
    \Drupal::messenger()->addWarning(t('I documenti di tipo "@tipologia" contengono dati personali e non si pubblicano (Regolamento dell\'albo, artt. 4 e 7): il documento è stato salvato come non pubblicato ed è consultabile nell\'albo storico riservato.', ['@tipologia' => $tipologia]));
    \Drupal::logger('custom_config_keryx')->notice('Documento "@titolo" di tipo "@tipologia" salvato come non pubblicato (tipologia non pubblicabile).', ['@titolo' => $node->label(), '@tipologia' => $tipologia]);
  }
}

/**
 * Durata ordinaria della pubblicazione all'albo, in giorni interi.
 */
const CUSTOM_CONFIG_KERYX_DURATA_GIORNI = 15;

/**
 * Durata massima ammessa per la pubblicazione all'albo, in giorni.
 */
const CUSTOM_CONFIG_KERYX_DURATA_MASSIMA_GIORNI = 60;

/**
 * Scadenza della pubblicazione dopo il numero di giorni indicato.
 *
 * Giorni interi e consecutivi dal giorno successivo alla pubblicazione, con
 * scadenza alle 24.00 dell'ultimo giorno; se l'ultimo giorno è festivo, la
 * scadenza slitta al primo giorno lavorativo (Regolamento dell'albo, art. 5).
 */
function _custom_config_keryx_scadenza(int $giorni): DrupalDateTime {
  $scadenza = new DrupalDateTime('today');
  $scadenza->modify('+' . $giorni . ' days');
  while (_custom_config_keryx_is_festivo($scadenza)) {
    $scadenza->modify('+1 day');
  }
  $scadenza->setTime(23, 59, 59);
  return $scadenza;
}

/**
 * Entity builder del form dei documenti: durata della pubblicazione all'albo.
 *
 * themethla propone per i documenti una data di oblio a +10 anni, adatta ai
 * documenti in generale ma non agli atti dell'albo, che resterebbero
 * nell'albo online per anni. Se un atto dell'albo viene pubblicato dal form
 * senza data di oblio o con una durata oltre il massimo ammesso (60 giorni),
 * si applica la durata ordinaria di 15 giorni (Regolamento dell'albo, art. 5).
 *
 * Il controllo è solo nel form: le migrazioni importano le date originali.
 */
function _custom_config_keryx_durata_albo_builder($entity_type, NodeInterface $node, array &$form, FormStateInterface $form_state) {
  if (!$node->isPublished() || !$node->hasField('field_data_oblio') || !_custom_config_keryx_is_atto_albo($node)) {
    return;
  }
  // I non pubblicabili sono gestiti in presave (non pubblicati, archivio).
  if (_custom_config_keryx_is_non_pubblicabile($node)) {
    return;
  }
  // Solo su un atto nuovo, alla prima pubblicazione o se la data di oblio
  // viene cambiata: modificare altri campi di un atto già pubblicato (es. un
  // refuso nel titolo) non deve accorciarne la pubblicazione in corso.
  if (!$node->isNew()) {
    $salvato = \Drupal::entityTypeManager()->getStorage('node')->loadUnchanged($node->id());
    if ($salvato && $salvato->isPublished() && $salvato->get('field_data_oblio')->value === $node->get('field_data_oblio')->value) {
      return;
    }
  }

  $valore = $node->get('field_data_oblio')->value;
  if ($valore) {
    $oblio = new DrupalDateTime($valore, DateTimeItemInterface::STORAGE_TIMEZONE);
    if ($oblio <= _custom_config_keryx_scadenza(CUSTOM_CONFIG_KERYX_DURATA_MASSIMA_GIORNI)) {
      return;
    }
  }

  $scadenza = _custom_config_keryx_scadenza(CUSTOM_CONFIG_KERYX_DURATA_GIORNI);
  $utc = clone $scadenza;
  $utc->setTimezone(new \DateTimeZone(DateTimeItemInterface::STORAGE_TIMEZONE));
  $node->set('field_data_oblio', $utc->format(DateTimeItemInterface::DATETIME_STORAGE_FORMAT));

  // L'entity builder gira sia in validazione sia in invio: un solo avviso.
  if (!$form_state->get('custom_config_keryx_avviso_durata')) {
    $form_state->set('custom_config_keryx_avviso_durata', TRUE);
    \Drupal::messenger()->addWarning(t('Durata non ammessa per l\'Albo online: data di fine pubblicazione impostata al @data (@giorni giorni, Regolamento dell\'albo art. 5). Per una durata diversa indicare una data entro @massimo giorni.', [
      '@data' => $scadenza->format('d/m/Y'),
      '@giorni' => CUSTOM_CONFIG_KERYX_DURATA_GIORNI,
      '@massimo' => CUSTOM_CONFIG_KERYX_DURATA_MASSIMA_GIORNI,
    ]));
  }
}

/**
 * Indica se il giorno è festivo: domenica o festività nazionale.
 */
function _custom_config_keryx_is_festivo(DrupalDateTime $giorno): bool {
  if ($giorno->format('N') === '7') {
    return TRUE;
  }
  $anno = (int) $giorno->format('Y');
  $festivi = ['01-01', '01-06', '04-25', '05-01', '06-02', '08-15', '11-01', '12-08', '12-25', '12-26'];

  // Lunedì dell'Angelo: il giorno dopo Pasqua (algoritmo di Meeus/Jones/Butcher).
  $a = $anno % 19;
  $b = intdiv($anno, 100);
  $c = $anno % 100;
  $h = (19 * $a + $b - intdiv($b, 4) - intdiv($b - intdiv($b + 8, 25) + 1, 3) + 15) % 30;
  $l = (32 + 2 * ($b % 4) + 2 * intdiv($c, 4) - $h - ($c % 4)) % 7;
  $m = intdiv($a + 11 * $h + 22 * $l, 451);
  $mese = intdiv($h + $l - 7 * $m + 114, 31);
  $giorno_pasqua = (($h + $l - 7 * $m + 114) % 31) + 1;
  $pasquetta = (new \DateTime(sprintf('%d-%02d-%02d', $anno, $mese, $giorno_pasqua)))->modify('+1 day');
  $festivi[] = $pasquetta->format('m-d');

  return in_array($giorno->format('m-d'), $festivi, TRUE);
}

/**
 * Calcola il prossimo numero di registro per l'anno indicato.
 *
 * Il progressivo riparte da 1 a ogni anno solare: il primo atto del 2027 è
 * 2027000001. Numeri già presenti (anche migrati da PASW) fanno proseguire la
 * numerazione dell'anno.
 *
 * @param string $anno
 *   Anno solare a quattro cifre.
 *
 * @return string
 *   Il numero di registro, anno + progressivo a 6 cifre.
 */
function _custom_config_keryx_next_registro(string $anno): string {
  $field = CUSTOM_CONFIG_KERYX_REGISTRO_FIELD;
  $lunghezza = strlen($anno) + CUSTOM_CONFIG_KERYX_REGISTRO_CIFRE;
  $massimo = \Drupal::database()->select('node__' . $field, 'r')
    ->condition('r.bundle', 'documento')
    ->condition('r.deleted', 0)
    ->condition('r.' . $field . '_value', \Drupal::database()->escapeLike($anno) . '%', 'LIKE')
    ->where('CHAR_LENGTH(r.' . $field . '_value) = :lunghezza', [':lunghezza' => $lunghezza])
    ->where('r.' . $field . '_value REGEXP :solo_cifre', [':solo_cifre' => '^[0-9]+$'])
    ->orderBy('r.' . $field . '_value', 'DESC')
    ->range(0, 1)
    ->fields('r', [$field . '_value'])
    ->execute()
    ->fetchField();

  $progressivo = $massimo ? ((int) substr($massimo, strlen($anno))) + 1 : 1;
  return $anno . str_pad((string) $progressivo, CUSTOM_CONFIG_KERYX_REGISTRO_CIFRE, '0', STR_PAD_LEFT);
}

/**
 * Implements hook_node_insert().
 */
function custom_config_keryx_node_insert(NodeInterface $node) {
  _custom_config_keryx_release_registro_lock($node);
}

/**
 * Implements hook_node_update().
 */
function custom_config_keryx_node_update(NodeInterface $node) {
  _custom_config_keryx_release_registro_lock($node);
}

/**
 * Rilascia il lock del registro preso in presave, a salvataggio avvenuto.
 */
function _custom_config_keryx_release_registro_lock(EntityInterface $node) {
  if (!empty($node->custom_config_keryx_registro_lock)) {
    \Drupal::lock()->release(CUSTOM_CONFIG_KERYX_REGISTRO_LOCK);
    unset($node->custom_config_keryx_registro_lock);
  }
}

/**
 * Implements hook_theme().
 *
 * Template dell'albo storico con lo stesso aspetto dell'albo online del tema
 * skenografia (la vista e il percorso diversi non ne ereditano i template).
 */
function custom_config_keryx_theme($existing, $type, $theme, $path) {
  if (!\Drupal::service('theme_handler')->themeExists('skenografia')) {
    return [];
  }
  $templates = \Drupal::service('extension.list.module')->getPath('custom_config_keryx') . '/templates';
  return [
    'views_view__albo_storico' => [
      'base hook' => 'views_view',
      'template' => 'views-view--albo-storico',
      'path' => $templates,
    ],
    'page__path__novita__albo_online__storico' => [
      'base hook' => 'page',
      'template' => 'page--path--novita--albo-online--storico',
      'path' => $templates,
    ],
  ];
}

/**
 * Implements hook_views_pre_view().
 *
 * L'Albo online di keryx elenca tutti i documenti pubblicati non scaduti:
 * vi entrerebbero anche i documenti di Amministrazione Trasparente, che non
 * sono atti di pubblicità legale. Si aggiunge il filtro "senza obbligo di
 * pubblicazione" (stessa regola di _custom_config_keryx_is_atto_albo()), senza
 * modificare la vista di keryx. L'albo storico ha lo stesso filtro nella sua
 * configurazione.
 */
function custom_config_keryx_views_pre_view(\Drupal\views\ViewExecutable $view, $display_id, array &$args) {
  if ($view->id() !== 'albo_online') {
    return;
  }
  $view->addHandler($display_id, 'filter', 'node__field_obbligo_di_pubblicazione', 'field_obbligo_di_pubblicazione_target_id', [
    'operator' => 'empty',
    'plugin_id' => 'taxonomy_index_tid',
    'vid' => 'obblighi_di_pubblicazione',
  ], 'custom_config_keryx_solo_albo');
}

/**
 * Implements hook_preprocess_HOOK() for views_view.
 *
 * Collegamenti tra albo online e albo storico nell'intestazione, solo per chi
 * può consultare lo storico (il tema non mostra le schede dei local task).
 */
function custom_config_keryx_preprocess_views_view(array &$variables) {
  $view = $variables['view'];
  $collegamenti = [
    'albo_online' => ['view.albo_storico.pagina_albo_storico', t('Consulta l\'albo storico')],
    'albo_storico' => ['view.albo_online.pagina_albo', t('Torna all\'albo online')],
  ];
  if (!isset($collegamenti[$view->id()]) || !$view->getDisplay()->hasPath()) {
    return;
  }
  $variables['#cache']['contexts'][] = 'user.permissions';
  if (!\Drupal::currentUser()->hasPermission('access albo storico')) {
    return;
  }
  [$route, $testo] = $collegamenti[$view->id()];
  $variables['header']['custom_config_keryx_albo_storico'] = [
    '#type' => 'link',
    '#title' => $testo,
    '#url' => \Drupal\Core\Url::fromRoute($route),
    '#attributes' => ['class' => ['btn', 'btn-sm', 'btn-outline-light', 'mt-3', 'mb-3']],
    '#weight' => 100,
  ];
}

/**
 * Implements hook_form_FORM_ID_alter() for views_exposed_form.
 *
 * Filtro per data di pubblicazione dell'albo storico: etichette in italiano
 * al posto di "Min" e "Max" (il formato gg-mm-aaaa è nei segnaposto della
 * vista e il filtro data di Drupal lo interpreta correttamente).
 */
function custom_config_keryx_form_views_exposed_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $view = $form_state->get('view');
  if (!$view || $view->id() !== 'albo_storico' || !isset($form['pubblicato_wrapper']['pubblicato_wrapper']['pubblicato'])) {
    return;
  }
  $date = &$form['pubblicato_wrapper']['pubblicato_wrapper']['pubblicato'];
  $date['min']['#title'] = t('Data minima');
  $date['max']['#title'] = t('Data massima');
  // Invio automatico dei filtri (BEF): non per le date, che scritte a metà
  // darebbero errore; si applicano con Invio o insieme agli altri filtri.
  $date['min']['#attributes']['data-bef-auto-submit-exclude'] = '';
  $date['max']['#attributes']['data-bef-auto-submit-exclude'] = '';
  // Il select della tipologia, sopra, non ha il margine inferiore dei campi
  // di testo: senza spazio l'etichetta "Data minima" sale sulla sua riga.
  $form['pubblicato_wrapper']['pubblicato_wrapper']['#attributes']['class'][] = 'mt-5';
  $form['#validate'][] = '_custom_config_keryx_albo_storico_data_massima';
}

/**
 * Include nella ricerca tutto il giorno della data massima.
 *
 * Il filtro data di Drupal legge "30-09-2025" come la mezzanotte all'inizio
 * del giorno ed esclude gli atti pubblicati in quel giorno.
 */
function _custom_config_keryx_albo_storico_data_massima(array &$form, FormStateInterface $form_state) {
  $max = trim((string) $form_state->getValue(['pubblicato', 'max']));
  if (preg_match('/^\d{1,2}-\d{1,2}-\d{4}$|^\d{4}-\d{1,2}-\d{1,2}$/', $max)) {
    $form_state->setValue(['pubblicato', 'max'], $max . ' 23:59:59');
  }
}

/**
 * Rotte degli elenchi dell'Albo online da non far indicizzare.
 */
const CUSTOM_CONFIG_KERYX_NOINDEX_ROUTES = [
  'view.albo_online.pagina_albo',
  'view.albo_storico.pagina_albo_storico',
];

/**
 * Implements hook_page_attachments_alter().
 *
 * Durante la pubblicazione gli atti dell'Albo online non devono essere
 * indicizzati dai motori di ricerca generalisti (Linee guida AgID sulla
 * pubblicità legale; Garante privacy, Linee guida n. 243/2014; Regolamento
 * dell'albo, art. 2): noindex sugli elenchi dell'albo e sulle pagine degli
 * atti. Per i file allegati vedi AlboRobotsSubscriber.
 */
function custom_config_keryx_page_attachments_alter(array &$attachments) {
  $route_match = \Drupal::routeMatch();
  $noindex = in_array($route_match->getRouteName(), CUSTOM_CONFIG_KERYX_NOINDEX_ROUTES, TRUE);

  if (!$noindex && $route_match->getRouteName() === 'entity.node.canonical') {
    $node = $route_match->getParameter('node');
    $noindex = $node instanceof NodeInterface && _custom_config_keryx_is_atto_albo($node);
  }

  if ($noindex) {
    $attachments['#attached']['html_head'][] = [
      [
        '#tag' => 'meta',
        '#attributes' => ['name' => 'robots', 'content' => 'noindex, nofollow'],
      ],
      'custom_config_keryx_robots',
    ];
  }
}

/**
 * Implements hook_form_BASE_FORM_ID_alter() for node_form.
 *
 * Nel form dei documenti il numero di registro non si compila a mano.
 */
function custom_config_keryx_form_node_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $node = $form_state->getFormObject()->getEntity();
  if (!$node instanceof NodeInterface || $node->bundle() !== 'documento' || !isset($form[CUSTOM_CONFIG_KERYX_REGISTRO_FIELD])) {
    return;
  }
  $form['#entity_builders'][] = '_custom_config_keryx_durata_albo_builder';
  $form['#validate'][] = '_custom_config_keryx_tipologia_validate';
  $form['#validate'][] = '_custom_config_keryx_nome_nel_titolo_validate';
  $widget = &$form[CUSTOM_CONFIG_KERYX_REGISTRO_FIELD]['widget'][0]['value'];
  if (!$node->isNew() && !$node->get(CUSTOM_CONFIG_KERYX_REGISTRO_FIELD)->isEmpty() && _custom_config_keryx_is_atto_albo($node)) {
    $form[CUSTOM_CONFIG_KERYX_REGISTRO_FIELD]['#disabled'] = TRUE;
    $widget['#description'] = t('Numero di registro dell\'Albo online: assegnato automaticamente, non modificabile.');
  }
  else {
    $widget['#description'] = t('Per gli atti dell\'Albo online (con numero di protocollo) il numero di registro viene assegnato automaticamente alla pubblicazione: lasciare vuoto.');
    $form['#validate'][] = '_custom_config_keryx_registro_validate';
  }
}

/**
 * Nome della tipologia del documento, se indicata.
 */
function _custom_config_keryx_tipologia(NodeInterface $node): ?string {
  if (!$node->hasField('field_tipologia_documento') || $node->get('field_tipologia_documento')->isEmpty()) {
    return NULL;
  }
  return $node->get('field_tipologia_documento')->entity?->label();
}

/**
 * Validazione del form: regole di pubblicazione per tipologia.
 *
 * Una tipologia "solo Amministrazione Trasparente" richiede l'obbligo di
 * pubblicazione AT: senza, il documento finirebbe nell'Albo online
 * (Regolamento dell'albo, art. 4). Le tipologie sono configurate in
 * Configurazione > Ouitoulía > Keryx: regole di pubblicazione.
 */
function _custom_config_keryx_tipologia_validate(array &$form, FormStateInterface $form_state) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->buildEntity($form, $form_state);
  $tipologia = _custom_config_keryx_tipologia($node);
  if ($tipologia === NULL) {
    return;
  }
  $solo_at = \Drupal::config('custom_config_keryx.settings')->get('tipologie_solo_at') ?? [];
  if (in_array($tipologia, $solo_at, TRUE) && $node->hasField('field_obbligo_di_pubblicazione') && $node->get('field_obbligo_di_pubblicazione')->isEmpty()) {
    $form_state->setErrorByName('field_obbligo_di_pubblicazione', t('La tipologia "@tipologia" si pubblica in Amministrazione Trasparente, non all\'Albo online: indicare l\'obbligo di pubblicazione nel riquadro "Amministrazione trasparente" (es. Bandi di gara e contratti). Regolamento dell\'albo, art. 4.', ['@tipologia' => $tipologia]));
  }
}

/**
 * Validazione del form: avviso (non bloccante) se l'oggetto contiene un nome.
 *
 * L'oggetto di un atto non deve contenere nomi di persone fisiche, salvo che
 * una norma lo richieda (Regolamento dell'albo, art. 7). Il controllo non può
 * essere infallibile, quindi avvisa senza bloccare. Scatta se l'oggetto:
 * - termina con "- Nome Cognome" (schema tipico degli incarichi nominativi);
 * - contiene nome e cognome di un utente del sito, in qualsiasi ordine.
 */
function _custom_config_keryx_nome_nel_titolo_validate(array &$form, FormStateInterface $form_state) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->buildEntity($form, $form_state);
  if (!$node->isPublished() || !_custom_config_keryx_is_atto_albo($node) || _custom_config_keryx_is_non_pubblicabile($node)) {
    return;
  }
  $trovato = _custom_config_keryx_nome_nel_titolo((string) $node->label());
  if ($trovato !== NULL) {
    \Drupal::messenger()->addWarning(t('L\'oggetto sembra contenere il nome di una persona («@nome»). Salvo che una norma lo richieda, l\'oggetto non deve contenere dati personali (Regolamento dell\'albo, art. 7). Verifica prima di pubblicare.', ['@nome' => $trovato]));
  }
}

/**
 * Cerca nel titolo un nome di persona; restituisce il testo trovato o NULL.
 */
function _custom_config_keryx_nome_nel_titolo(string $titolo): ?string {
  // "- Nome Cognome" in fondo all'oggetto.
  if (preg_match('/[-–]\s*(\p{Lu}[\p{L}\']+(?:\s+\p{Lu}[\p{L}\']+)+)\s*$/u', $titolo, $m)) {
    return $m[1];
  }

  // Nome e cognome di un utente del sito, adiacenti, in qualsiasi ordine.
  $minuscolo = mb_strtolower($titolo);
  foreach (_custom_config_keryx_nomi_utenti() as [$nome, $cognome]) {
    foreach (["$nome $cognome", "$cognome $nome"] as $coppia) {
      if (preg_match('/(?<![\p{L}])' . preg_quote($coppia, '/') . '(?![\p{L}])/u', $minuscolo, $m, PREG_OFFSET_CAPTURE)) {
        return mb_substr($titolo, mb_strlen(substr($minuscolo, 0, $m[0][1])), mb_strlen($coppia));
      }
    }
  }
  return NULL;
}

/**
 * Coppie [nome, cognome] in minuscolo degli utenti del sito (in cache).
 */
function _custom_config_keryx_nomi_utenti(): array {
  $cache = \Drupal::cache()->get('custom_config_keryx:nomi_utenti');
  if ($cache) {
    return $cache->data;
  }
  $query = \Drupal::database()->select('users_field_data', 'u');
  $query->join('user__field_nome', 'n', 'n.entity_id = u.uid AND n.deleted = 0');
  $query->join('user__field_cognome', 'c', 'c.entity_id = u.uid AND c.deleted = 0');
  $query->addField('n', 'field_nome_value', 'nome');
  $query->addField('c', 'field_cognome_value', 'cognome');
  $coppie = [];
  foreach ($query->execute() as $riga) {
    $nome = mb_strtolower(trim($riga->nome));
    $cognome = mb_strtolower(trim($riga->cognome));
    if (mb_strlen($nome) >= 2 && mb_strlen($cognome) >= 2) {
      $coppie["$nome|$cognome"] = [$nome, $cognome];
    }
  }
  $coppie = array_values($coppie);
  \Drupal::cache()->set('custom_config_keryx:nomi_utenti', $coppie, \Drupal\Core\Cache\Cache::PERMANENT, ['user_list']);
  return $coppie;
}

/**
 * Validazione del form: per un atto dell'albo non ancora numerato il numero
 * di registro non si inserisce a mano (lo assegna il sistema in presave).
 */
function _custom_config_keryx_registro_validate(array &$form, FormStateInterface $form_state) {
  /** @var \Drupal\node\NodeInterface $node */
  $node = $form_state->getFormObject()->buildEntity($form, $form_state);
  if (!_custom_config_keryx_is_atto_albo($node) || $node->get(CUSTOM_CONFIG_KERYX_REGISTRO_FIELD)->isEmpty()) {
    return;
  }
  $form_state->setValue([CUSTOM_CONFIG_KERYX_REGISTRO_FIELD, 0, 'value'], '');
  \Drupal::messenger()->addWarning(t('Il numero di registro dell\'Albo online viene assegnato automaticamente: il valore inserito è stato ignorato.'));
}

/**
 * Numero massimo di documenti spubblicati a ogni esecuzione del cron.
 *
 * Evita timeout quando molti documenti scadono insieme (per esempio dopo una
 * migrazione): i restanti vengono spubblicati alle esecuzioni successive.
 */
const CUSTOM_CONFIG_KERYX_CRON_LIMIT = 100;

/**
 * Implements hook_cron().
 *
 * Spubblica gli atti dell'Albo online la cui data di oblio è passata: a fine
 * pubblicazione l'atto non deve restare raggiungibile dal pubblico (URL
 * diretto, ricerca, altre viste) ma solo dall'albo storico riservato
 * (Regolamento dell'albo, art. 9; Garante, Linee guida n. 243/2014).
 *
 * Gli altri documenti non vengono toccati: per keryx, alla data di oblio
 * escono dagli elenchi ma restano raggiungibili da chi ha il link.
 */
function custom_config_keryx_cron() {
  $now = new DrupalDateTime('now', DateTimeItemInterface::STORAGE_TIMEZONE);
  $storage = \Drupal::entityTypeManager()->getStorage('node');

  // Atto dell'albo = con protocollo e senza obbligo di pubblicazione AT
  // (vedi _custom_config_keryx_is_atto_albo()).
  $nids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('type', 'documento')
    ->condition('status', NodeInterface::PUBLISHED)
    ->exists('field_protocollo')
    ->notExists('field_obbligo_di_pubblicazione')
    ->condition('field_data_oblio', $now->format(DateTimeItemInterface::DATETIME_STORAGE_FORMAT), '<')
    ->sort('nid')
    ->range(0, CUSTOM_CONFIG_KERYX_CRON_LIMIT)
    ->execute();

  if (!$nids) {
    return;
  }

  /** @var \Drupal\node\NodeInterface $node */
  foreach ($storage->loadMultiple($nids) as $node) {
    $node->setUnpublished();
    $node->setNewRevision(TRUE);
    $node->setRevisionCreationTime(\Drupal::time()->getRequestTime());
    $node->setRevisionLogMessage('Pubblicazione all\'albo scaduta: atto spubblicato automaticamente alla data di fine pubblicazione.');
    $node->save();
  }

  \Drupal::logger('custom_config_keryx')->notice(
    'Spubblicati @count atti dell\'albo con pubblicazione scaduta (nid: @nids).',
    ['@count' => count($nids), '@nids' => implode(', ', $nids)]
  );
}

/**
 * Implements hook_node_access().
 *
 * Albo storico: gli atti con pubblicazione scaduta vengono spubblicati, ma
 * devono restare consultabili dai responsabili della pubblicazione (permesso
 * "access albo storico"). L'accesso è concesso solo ai documenti non
 * pubblicati con numero di protocollo, cioè agli atti dell'Albo online, e non
 * agli altri contenuti non pubblicati del sito.
 */
function custom_config_keryx_node_access(NodeInterface $node, $operation, AccountInterface $account) {
  if ($operation !== 'view' || $node->bundle() !== 'documento' || $node->isPublished()) {
    return AccessResult::neutral();
  }

  $atto_albo = $node->hasField('field_protocollo') && !$node->get('field_protocollo')->isEmpty();

  return AccessResult::allowedIf($atto_albo && $account->hasPermission('access albo storico'))
    ->cachePerPermissions()
    ->addCacheableDependency($node);
}
