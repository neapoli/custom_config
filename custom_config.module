<?php

use Drupal\Core\Datetime\DrupalDateTime;

/**
 * Implements hook_entity_presave().
 */
function custom_config_entity_presave(Drupal\Core\Entity\EntityInterface $entity) {
  switch ($entity->bundle()) {
    // Setting the title with the value of field_date.
    //$entity->setTitle($entity->get('field_date')->value);
    // Here you modify only your day content type
    case 'circolare':
      //Prendo il valore del Tipo di CIRCOLARE(Sciopero, Assemblea, ecc...)
      $tipoCircolareId = $entity->get('field_tipologia_circolare')->target_id;
      $tipoCircolareLoad = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($tipoCircolareId);
      $tipoCircolareName = $tipoCircolareLoad->getName();
      \Drupal::messenger()->addWarning($tipoCircolareName);
      switch ($tipoCircolareName){
        case 'Adesione Iniziative':
          $entity->set('alternate_form', TRUE);
          $entity->alternate_form_text="Aderisco
          NON Aderisco";

          break;
        case 'Assemblea Sindacale':
          $entity->set('alternate_form', TRUE);
          $entity->alternate_form_text="NON sono in servizio
          Non sono in servizio ma PARTECIPO all assemblea in oggetto
          Sono in servizio e PARTECIPO all'assemblea in oggetto
          Sono in servizio e NON PARTECIPO all'assemblea in oggetto";

          break;
        case 'Evento':
          $entity->set('alternate_form', TRUE);
          $entity->alternate_form_text="PARTECIPO
          NON Partecipo";

          break;
        case 'Sciopero':
          $entity->set('alternate_form', TRUE);
          $entity->alternate_form_text="DICHIARO la mia intenzione di ADERIRE ALLO SCIOPERO consapevole che la presente dichiarazione è irrevocabile e fa fede ai fini della trattenuta sulla busta paga
          DICHIARO la mia intenzione di NON ADERIRE ALLO SCIOPERO
          DICHIARO di NON AVER ANCORA MATURATO alcuna decisione sull'adesione o meno allo sciopero";

          break;
      }
      break;
  }
}

/**
 * Vocabolari le cui pagine dei termini mostrano i filtri esposti.
 *
 * La vista taxonomy_term (pagina di un termine) è unica per tutti i
 * vocabolari: i filtri "Titolo" e "Tipo di contenuto" servono solo qui.
 * "argomenti" = "Le parole della scuola".
 */
const CUSTOM_CONFIG_TAXONOMY_TERM_FILTRI_VOCABOLARI = ['argomenti'];

/**
 * Implements hook_views_pre_view().
 *
 * Nella pagina di un termine toglie i filtri esposti se il termine non
 * appartiene a uno dei vocabolari di CUSTOM_CONFIG_TAXONOMY_TERM_FILTRI_VOCABOLARI.
 */
function custom_config_views_pre_view(\Drupal\views\ViewExecutable $view, $display_id, array &$args) {
  if ($view->id() !== 'taxonomy_term' || $display_id !== 'page_1') {
    return;
  }
  $term = !empty($args[0]) && is_numeric($args[0])
    ? \Drupal::entityTypeManager()->getStorage('taxonomy_term')->load($args[0])
    : NULL;
  if ($term && in_array($term->bundle(), CUSTOM_CONFIG_TAXONOMY_TERM_FILTRI_VOCABOLARI, TRUE)) {
    return;
  }
  $display = $view->displayHandlers->get($display_id);
  $filters = array_filter($display->getOption('filters'), fn($filter) => empty($filter['exposed']));
  $display->setOption('filters', $filters);
}

/**
 * Applica una cartella di configurazioni sovrascrivendo anche ciò che esiste.
 *
 * Drupal installa da config/optional solo ciò che nel sito non c'è ancora: ma
 * le impostazioni di acknowledgements e di tac_lite, e il campo body della
 * circolare, le creano i rispettivi moduli quando vengono installati, cioè
 * prima di custom_config. Restavano quindi quelle predefinite: la circolare
 * non risultava abilitata alle prese visione e mancavano i permessi per
 * destinatari. config/update, invece, all'installazione non veniva applicata
 * affatto: la riapplica solo l'hook che parte dopo "drush updb".
 *
 * Le impostazioni semplici si sovrascrivono; le entità di configurazione
 * (campi, vocabolari, viste…) passano dalle loro API, così Drupal aggiorna
 * anche tabelle e cache, e quelle già presenti tengono il proprio uuid.
 * Si salta, segnalandolo nel registro, ciò che dipende da un modulo o da un
 * tema non installato, o da una configurazione che non c'è: lo stesso criterio
 * di Drupal, ma senza bloccare tutto il resto per un solo file.
 *
 * Serve anche ai sottomoduli (custom_config_keryx), per questo sta nel file
 * .module e non nel .install, che Drupal carica solo per il proprio modulo.
 *
 * @param string $cartella
 *   La sottocartella di config: 'optional' o 'update'.
 * @param string $modulo
 *   Il modulo da cui leggere la cartella.
 *
 * @return string[]
 *   I nomi delle configurazioni applicate.
 */
function _custom_config_apply_configs($cartella, $modulo = 'custom_config') {
  $path = \Drupal::service('extension.list.module')->getPath($modulo) . '/config/' . $cartella;
  if (!is_dir($path)) {
    return [];
  }

  $source = new \Drupal\Core\Config\FileStorage($path);
  $config_manager = \Drupal::service('config.manager');
  $entity_type_manager = \Drupal::entityTypeManager();
  $module_handler = \Drupal::moduleHandler();
  $theme_handler = \Drupal::service('theme_handler');
  $presenti = array_flip(\Drupal::service('config.storage')->listAll());
  $applicate = [];
  $saltate = [];

  // Prima ciò da cui dipende il resto: i campi dopo i loro storage.
  $dati = $source->readMultiple($source->listAll());
  $ordine = new \Drupal\Core\Config\Entity\ConfigDependencyManager();
  $dati = array_merge(array_flip($ordine->setData($dati)->sortAll()), $dati);

  foreach ($dati as $nome => $data) {
    $entity_type_id = $config_manager->getEntityTypeIdByName($nome);

    // Le impostazioni semplici appartengono al modulo del prefisso.
    $dipendenze = $data['dependencies'] ?? [];
    $moduli = array_merge($dipendenze['module'] ?? [], $dipendenze['enforced']['module'] ?? []);
    $temi = array_merge($dipendenze['theme'] ?? [], $dipendenze['enforced']['theme'] ?? []);
    $config = array_merge($dipendenze['config'] ?? [], $dipendenze['enforced']['config'] ?? []);
    if (!$entity_type_id) {
      $moduli[] = strstr($nome, '.', TRUE);
    }

    $mancanti = [];
    foreach (array_unique($moduli) as $modulo) {
      if ($modulo !== 'core' && !$module_handler->moduleExists($modulo)) {
        $mancanti[] = $modulo;
      }
    }
    foreach (array_unique($temi) as $tema) {
      if (!$theme_handler->themeExists($tema)) {
        $mancanti[] = $tema;
      }
    }
    foreach ($config as $necessaria) {
      if (!isset($presenti[$necessaria])) {
        $mancanti[] = $necessaria;
      }
    }
    if ($mancanti) {
      $saltate[] = $nome . ' (' . implode(', ', $mancanti) . ')';
      continue;
    }

    try {
      if (!$entity_type_id) {
        \Drupal::configFactory()->getEditable($nome)->setData($data)->save(TRUE);
      }
      else {
        /** @var \Drupal\Core\Config\Entity\ConfigEntityStorageInterface $storage */
        $storage = $entity_type_manager->getStorage($entity_type_id);
        $id = $storage->getIDFromConfigName($nome, $storage->getEntityType()->getConfigPrefix());
        $esistente = $storage->load($id);

        if ($esistente) {
          $data['uuid'] = $esistente->uuid();
          $entity = $storage->updateFromStorageRecord($esistente, $data);
        }
        else {
          $entity = $storage->createFromStorageRecord($data);
        }
        // Come fa l'importazione delle configurazioni di Drupal: in modalità
        // sincronizzazione le entità non verificano i plugin che citano (un
        // fornitore di geocoder non installato fermerebbe tutto).
        $entity->setSyncing(TRUE);
        $entity->save();
      }
    }
    catch (\Throwable $e) {
      $saltate[] = $nome . ' (' . $e->getMessage() . ')';
      continue;
    }

    $presenti[$nome] = TRUE;
    $applicate[] = $nome;
  }

  foreach ($saltate as $saltata) {
    \Drupal::logger('custom_config')->warning('@modulo/config/@cartella, non applicata: @saltata', [
      '@modulo' => $modulo,
      '@cartella' => $cartella,
      '@saltata' => $saltata,
    ]);
  }

  return $applicate;
}
